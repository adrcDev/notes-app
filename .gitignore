# RULES FOR frontend folder
/frontend/dist/
/frontend/node_modules/
/frontend/.vscode/  
/frontend/.eslintcache
/frontend/.cache/

# RULES FOR swagger-ui folder
/swagger-ui/dist/
/swagger-ui/node_modules/
/swagger-ui/.vscode/
/swagger-ui/.eslintcache
/swagger-ui/.cache/

# Logs
/frontend/npm-debug.log*

# OS clutter
**/.DS_Store
**/Thumbs.db
**/Desktop.ini



# RULES FOR backend folder
/backend/**/HELP.md
/backend/**/target/
/backend/**/.mvn/wrapper/maven-wrapper.jar
!/backend/**/src/main/**/target/
!/backend/**/src/test/**/target/
/backend/*.log

### Spring Tool Suite ###
/backend/**/.apt_generated
/backend/**/.classpath
/backend/**/.factorypath
/backend/**/.project
/backend/**/.settings
/backend/**/.springBeans
/backend/**/.sts4-cache

### IntelliJ IDEA ###
/backend/**/.idea
/backend/**/*.iws
/backend/**/*.iml
/backend/**/*.ipr

### NetBeans ###
/backend/nbproject/private/
/backend/nbbuild/
/backend/dist/
/backend/nbdist/
/backend/.nb-gradle/
